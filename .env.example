# ============================================================
# Backend QFS application
# Build context: Backend repository root
# ============================================================

PORT=8000
APP_BASE_PATH=/trading_eng_backend
PUBLIC_BASE_URL=https://qfsplatform.com/trading_eng_backend
FORWARDED_ALLOW_IPS=*

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
ALLOWED_HOSTS=qfsplatform.com,127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=https://qfsplatform.com
CSRF_TRUSTED_ORIGINS=https://qfsplatform.com


# ============================================================
# PostgreSQL
# ============================================================

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=trading_engine_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=H95M5GblRGJleTumK0lYWg2QWB0W

# Database used while checking/creating the application database.
POSTGRES_MAINTENANCE_DB=postgres

# Startup retry configuration.
DATABASE_BOOTSTRAP_MAX_ATTEMPTS=30
DATABASE_BOOTSTRAP_RETRY_SECONDS=2

DATABASE_URL=postgresql://admin:H95M5GblRGJleTumK0lYWg2QWB0W@postgres:5432/trading_engine_db


# ============================================================
# Redis and Celery
# ============================================================

REDIS_URL=redis://:QEd7qFLBk2TbuR6bUak6zgPsk6TE@redis:6379/7
CELERY_BROKER_URL=redis://:QEd7qFLBk2TbuR6bUak6zgPsk6TE@redis:6379/9

# Store Celery task results through the Django ORM.
CELERY_RESULT_BACKEND=django-db


# ============================================================
# Portfolio target coordination
# ============================================================

PORTFOLIO_TARGET_MAX_AGE_SECONDS=900
PORTFOLIO_TARGET_COORDINATION_DEBOUNCE_SECONDS=2
PORTFOLIO_TARGET_COORDINATION_BATCH_SIZE=50
PORTFOLIO_TARGET_COORDINATION_RETRY_BASE_SECONDS=5
PORTFOLIO_TARGET_COORDINATION_RETRY_MAX_SECONDS=300


# ============================================================
# Strategy execution
# ============================================================

EXECUTION_AVERAGE_VOLUME_WINDOW=20
EXECUTION_REGISTER_ADV_INPUT=true
EXECUTION_ADV_TIMEFRAME=RUNTIME

STRATEGY_JOB_BACKLOG_THRESHOLD=100
TARGET_COORDINATION_BACKLOG_THRESHOLD=100
PENDING_INTENT_MAX_AGE_SECONDS=60
ORDER_INTENT_CLAIM_TIMEOUT_SECONDS=120
BROKER_COMMAND_MAX_AGE_SECONDS=60


# ============================================================
# Kafka and Flink
# ============================================================

# Kafka uses its own protocol. Do not add http:// here.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_ENABLED=true
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1
KAFKA_BOOTSTRAP_MAX_ATTEMPTS=30
KAFKA_BOOTSTRAP_RETRY_SECONDS=2
KAFKA_ADMIN_TIMEOUT_SECONDS=15

EXECUTION_REQUIRED_KAFKA_TOPICS=market.raw.v1,market.canonical.v1,market.bars.v1,market.indicators.v1,market.quality.v1,instrument.registry.v1,strategy.inputs.v1,strategy.targets.v1,portfolio.rebalance.planned.v1,risk.decisions.v1,orders.events.v1,executions.events.v1,reconciliation.events.v1,system.health.v1,dead-letter.v1
FLINK_REST_URL=http://flink-jobmanager:8081
EXECUTION_REQUIRED_FLINK_JOBS=market-normalization-v2,bar-aggregation-v2,indicator-computation-v2,stale-price-detection-v1,stream-health-v1
FLINK_CHECKPOINT_STALE_SECONDS=180
EXECUTION_READINESS_HTTP_TIMEOUT_SECONDS=2


# ============================================================
# Pipeline health
# ============================================================

MARKET_RAW_PRODUCER_HEARTBEAT_STALE_SECONDS=30
MARKET_CONSUMER_HEARTBEAT_STALE_SECONDS=30
KAFKA_HEALTH_STALE_SECONDS=60
OUTBOX_PUBLISHER_HEARTBEAT_STALE_SECONDS=30
EXECUTION_ACTIVATION_PREFLIGHT_ENABLED=true
EXECUTION_WORKER_HEARTBEAT_STALE_SECONDS=30
GATEWAY_CONNECTIVITY_STALE_SECONDS=30


# ============================================================
# Broker Gateway
# ============================================================

GATEWAY_HTTP_TIMEOUT_SECONDS=10
GATEWAY_COMMAND_POLL_INTERVAL_SECONDS=0.25
GATEWAY_COMMAND_TIMEOUT_DEFAULT_SECONDS=20
GATEWAY_COMMAND_TIMEOUT_SEARCH_CONTRACTS_SECONDS=15
GATEWAY_COMMAND_TIMEOUT_QUALIFY_SECONDS=20
GATEWAY_COMMAND_TIMEOUT_HISTORICAL_DATA_SECONDS=60
GATEWAY_COMMAND_TIMEOUT_HISTORICAL_SCHEDULE_SECONDS=30
GATEWAY_SAFE_COMMAND_RETRIES=1
GATEWAY_CONTRACT_SEARCH_MAX_RESULTS=12
GATEWAY_IBKR_REQUEST_TIMEOUT_SEARCH_CONTRACTS_SECONDS=12
GATEWAY_IBKR_REQUEST_TIMEOUT_QUALIFY_SECONDS=15


# ============================================================
# QCH
# QCH injects these values into the Backend process.
# ============================================================

QCH_APP_ID=
QCH_API_HOST=
QCH_SERVICE_TOKEN=


# ============================================================
# Managed private child containers
# ============================================================

IBKR_GATEWAY_IMAGE=docker.io/rachitm4555/trading-engine-ib-gateway@sha256:c2442c0748e26febfd8c1c89b3ac8bfcbfde3b1f31bb54f6cc5114bdeb5f1ed6
BROKER_SESSION_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key

# Leave blank to use the QCH platform-default network.
QCH_SUBCONTAINER_NETWORK=


# ============================================================
# Operational policy
# ============================================================

ALLOW_LIVE_TRADING=false
GLOBAL_KILL_SWITCH=false


# ============================================================
# Finnhub and market-data fallback
# ============================================================

FINNHUB_API_KEY=
FINNHUB_ENCRYPTION_KEY=
FINNHUB_API_KEY_OVERRIDE_ENABLED=false

MARKET_DATA_FALLBACK_ENABLED=false
FINNHUB_HISTORICAL_FALLBACK_ENABLED=false
FINNHUB_LIVE_FALLBACK_ENABLED=false
FINNHUB_AUTO_FAILBACK_ENABLED=false


# ============================================================
# Research and recommendations
# ============================================================

RESEARCH_ENABLED=true
RECOMMENDATION_SYSTEM_ENABLED=true
RESEARCH_BUNDLE_PATH=/app/research_bundle
RESEARCH_ARTIFACT_ROOT=/app/research_artifacts
RESEARCH_MAX_PARALLEL_DATA_TASKS=8
RESEARCH_MAX_PARALLEL_BACKTEST_TASKS=8